<Window x:Class="demo.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Карточка товара" Height="750" Width="800"
        FontSize="18" FontFamily="Calibri" Background="#FFFFFF">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Product.Name}" Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="10" TextAlignment="Center"/>

        <Image Source="{Binding Product.Image}" Grid.Row="1" Grid.ColumnSpan="2" Width="200" HorizontalAlignment="Center" Margin="10"/>

        <TextBlock Grid.Row="2" Grid.Column="0" TextWrapping="Wrap" Margin="10">
            <Run Text="Производство: "/>
            <Run Text="{Binding Product.Productoin}"/>
        </TextBlock>

        <TextBlock Grid.Row="3" Grid.Column="0" TextWrapping="Wrap" Margin="10">
            <Run Text="Описание: "/>
            <Run Text="{Binding Product.Description}"/>
        </TextBlock>

        <TextBlock Grid.Row="4" Grid.Column="0" TextWrapping="Wrap" Margin="10">
            <Run Text="Состав: "/>
            <Run Text="{Binding Product.Composition}"/>
        </TextBlock>

        <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="10">
            <Run Text="Размерный ряд: "/>
            <Run Text="{Binding SizeRange}"/>
        </TextBlock>

        <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Margin="10">
            <Run Text="Цена за штуку: "/>
            <Run Text="{Binding Product.Price, StringFormat={}{0:F2} руб.}"/>
        </TextBlock>

        <StackPanel  Grid.Column="1" Grid.Row="4" Orientation="Vertical" Margin="10">
            <TextBlock Text="Выберите доступный для заказа размер" Margin="0,0,10,0" TextWrapping="Wrap"/>

            <ComboBox ItemsSource="{Binding AvailablePairs}"
                      DisplayMemberPath="Size"
                      SelectedItem="{Binding SelectedPair}" SelectionChanged="ComboBox_SelectionChanged"/>
        </StackPanel>
        <StackPanel  Grid.Column="1" Grid.Row="5" Orientation="Vertical" Margin="10">
            <TextBlock Text="Введите количество" Margin="0,0,10,0" TextWrapping="Wrap"/>

            <TextBox Name="CountBox" TextChanged="CountBox_TextChanged"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="6" VerticalAlignment="Bottom"
                    Orientation="Vertical"
                    Margin="10"
                    HorizontalAlignment="Right">
            <TextBlock FontSize="23" >
                <Run Text="Итого: "/>
                <Run x:Name="TotalPriceRun" Text="0.00 руб."/>
            </TextBlock>
            <Button Name="MakeOrderBtn" Content="Оформить заказ" Width="200" Padding="5" Background="#70B2AF" Click="MakeOrderBtn_Click" HorizontalAlignment="Right"/>
        </StackPanel>

        <Button 
            Name="CancelBtn"
            Content="Отменить" Width="200" Padding="5" Background="#D2F6E7"
            Grid.Column="0" Grid.Row="6" VerticalAlignment="Bottom"    
            Margin="10" HorizontalAlignment="Left" Click="CancelBtn_Click"/>

    </Grid>
</Window>