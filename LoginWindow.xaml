<Window x:Class="demo.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo"
        mc:Ignorable="d"
        Title="Главное окно" Height="400" Width="400"
        FontFamily="Calibri"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Image Source="/Images/Чудо Обувь.png" Width="100"/>
        <TextBlock Text="Чудо обувь" TextAlignment="Center" FontSize="20" Margin="0,0,0,20"/>
        <TextBlock Text="Вход в систему" TextAlignment="Center" FontSize="30" Margin="0,0,0,20"/>
        <TextBlock Text="Логин" FontSize="18" Margin="0,0,0,10"/>
        <TextBox Name="LoginTxt" FontSize="18" Margin="0,0,0,10"/>
        <Button Name="LoginBtn" Content="Войти" FontSize="18" Background="#70B2AF" Click="LoginBtn_Click"/>
    </StackPanel>
</Window>
